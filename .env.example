# Stellar testnet. Never commit real secret keys; .env is gitignored.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed contract and tokens
# Optional override; the default is config/testnet.json
PROOF_OF_STAY_CONTRACT_ID=
USDC_SAC_ID=CBP2AG64D4IVGM5D4IEF353OUGNHCSL4QT36TZIA7QE2ITP22UWAEL5S

# Accounts (stellar-cli key aliases, secrets stay in the local stellar keystore)
ARBITER_KEY=arbiter
HOTEL_KEYS=hotel1,hotel2,hotel3
DEPLOYER_KEY=deployer
USDC_ISSUER_KEY=usdc-issuer
GUEST_KEYS=guest1,guest2
RELAYER_KEY=relayer

# Frontend
VITE_RPC_URL=https://soroban-testnet.stellar.org

# BookerBob backend (server/). Testnet demo keys, set as host secrets, never committed.
RELAYER_SECRET=
ARBITER_SECRET=
USDC_ISSUER_SECRET=
# comma-separated admin secrets of the demo places the demo desk checks guests into
DEMO_MERCHANT_SECRETS=
DATA_DIR=/data
PORT=8080

# Seed (scripts/seed.ts): per-stay identity master for seed guests; generated into .env on first run
SEED_MASTER=

# Static roots and release label (server/src/index.ts, ops.ts)
SITE_DIR=
STATIC_DIR=
RELEASE=
# token for reading the ops error feed
OPS_TOKEN=

# REP verified traveler (server/src/rep.ts). Testnet keys as host secrets, never committed.
REP_ATTESTER_SECRET=
REP_RELAYER_SECRET=
REP_GROUP_ID=
REP_SPENT_SALT=
# operator cookie token for the demo gate; never print it
REP_DEMO_TOKEN=
# 1 = tier path on chain (add_member_with_tier) through the tier issuer at REP_TIER_URL
REP_ONCHAIN=
REP_TIER_URL=

# Stellar wallet tier group (server/src/stellar-tier.ts)
STELLAR_TIER_ATTESTER_SECRET=
STELLAR_TIER_GROUP_ID=
STELLAR_TIER_MIN=
STELLAR_TIER_SALT=
PASSPORT_API_KEY=
PASSPORT_BASE_URL=
# 1 = enable the public wallet and tier attest (POST /api/loyalty/attest); off on the live demo
LOYALTY_ATTEST=

# Partner hotel snapshot (scripts/jmpr-snapshot.ts); the server reads the static snapshot only
JMPR_ENABLED=
JMPR_MCP_URL=
JMPR_TOKEN=

# UCP bridge the server links to; the bridge's own variables are in ucp/.env.example
UCP_BRIDGE_URL=
