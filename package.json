{
  "name": "bookerbob-ucp-module",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UCP bridge: a buyer's agent claims a returning-customer discount at a Shopify store with a Semaphore v4 proof verified on Stellar.",
  "scripts": {
    "bridge": "tsx --env-file=.env src/bridge.ts",
    "agent": "tsx --env-file=.env agent/agent.ts",
    "probe": "node --env-file=.env scripts/probe.mjs",
    "visit": "tsx --env-file=.env agent/visit.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@semaphore-protocol/group": "^4.14.5",
    "@semaphore-protocol/identity": "^4.14.5",
    "@stellar/stellar-sdk": "^17.4.0",
    "ethers": "^6.13.4",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
